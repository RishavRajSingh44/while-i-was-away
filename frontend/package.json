    "@testing-library/react": "16.3.0",
    "@types/node": "22.14.0",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.1",
    "@vitejs/plugin-react": "4.4.1",
    "eslint": "9.24.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.0.0",
    "jsdom": "26.0.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.29.1",
    "vite": "6.3.5",
    "vitest": "3.1.1"
